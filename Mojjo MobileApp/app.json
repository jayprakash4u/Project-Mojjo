{
  "expo": {
    "name": "Mojjo",
    "slug": "mojjo-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1F2A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mojjo.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1F2A"
      },
      "package": "com.mojjo.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "mojjo",
    "plugins": [
      "expo-secure-store",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}
