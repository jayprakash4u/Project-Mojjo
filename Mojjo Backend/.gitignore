# ==============================================================================
# Mojjo E-Commerce Backend - Git Ignore Policy
# Prevents accidental commits of secrets, compiled binaries, logs, and uploads
# ==============================================================================

# 1. Secrets & Environment Configuration Files (NEVER COMMIT REAL CREDENTIALS)
.env
.env.*
!.env.example
secrets.json
appsettings.*.local.json
appsettings.local.json
*.local.json

# 2. Build & Compilation Artifacts
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa]rm/
[Aa]rm64/
[Tt]emp/
[Tt]mp/
*.dll
*.exe
*.pdb
*.cache

# 3. IDE, Editor & User Files
.vs/
.idea/
.vscode/
*.user
*.userprefs
*.suo
*.userosscache
*.sln.docstates
*.DotSettings.user

# 4. Logs & Diagnostic Output
logs/
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 5. User Uploaded Files & Static Media (Keep folder structure via .gitkeep)
src/Mojjo.Api/wwwroot/uploads/*
!src/Mojjo.Api/wwwroot/uploads/.gitkeep
!src/Mojjo.Api/wwwroot/uploads/*/.gitkeep

# 6. Database & Local Storage Files
*.mdf
*.ldf
*.sqlite
*.sqlite3
*.db

# 7. OS Generated Files
Thumbs.db
[Dd]esktop.ini
.DS_Store
.Spotlight-V100
.Trashes
