# ==============================================================================
# Mojjo E-Commerce Backend - Environment Variables Template
# Copy this file to .env or inject these variables in Docker/Kubernetes/CI/CD
# In ASP.NET Core, double underscore (__) denotes JSON nesting
# ==============================================================================

# ASP.NET Core Runtime Environment
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:5000;https://+:5001

# Database Connection String (SQL Server)
ConnectionStrings__DefaultConnection=Server=sqlserver.internal;Database=MojjoDb;User Id=sa;Password=YourStrongProductionPassword123!;TrustServerCertificate=True;MultipleActiveResultSets=true;
ConnectionStrings__Redis=redis.internal:6379,abortConnect=false

# JWT Authentication & Token Security (Must be at least 32 characters in production)
JwtSettings__Secret=YourSuperSecretProductionJwtKeyMin32CharactersLong2026!#
JwtSettings__Issuer=Mojjo.Api
JwtSettings__Audience=Mojjo.Client
JwtSettings__ExpiryMinutes=15

# Payment Gateway Credentials (eSewa & Khalti)
PaymentSettings__Esewa__ProductCode=EPAYTEST
PaymentSettings__Esewa__SecretKey=8gBm/:&EnhH.1/q
PaymentSettings__Esewa__BaseUrl=https://rc-epay.esewa.com.np
PaymentSettings__Esewa__SuccessUrl=https://mojjo.com/checkout/payment-success
PaymentSettings__Esewa__FailureUrl=https://mojjo.com/checkout/payment-failed

PaymentSettings__Khalti__PublicKey=test_public_key_dc74e0fd12724f63b0f8308e49f33fef
PaymentSettings__Khalti__SecretKey=test_secret_key_8b9911e3b5be4910b8cfb46536004d44
PaymentSettings__Khalti__BaseUrl=https://a.khalti.com/api/v2
PaymentSettings__Khalti__ReturnUrl=https://mojjo.com/checkout/payment-success
PaymentSettings__Khalti__WebsiteUrl=https://mojjo.com

# Storage & CDN Settings
StorageSettings__CdnBaseUrl=https://cdn.mojjo.com
StorageSettings__UploadDirectory=wwwroot/uploads
StorageSettings__MaxFileSizeMb=5

# SMTP Email Settings (Optional / Transactional Notifications)
SmtpSettings__Host=smtp.sendgrid.net
SmtpSettings__Port=587
SmtpSettings__Username=apikey
SmtpSettings__Password=YourSendgridApiKeyHere
SmtpSettings__FromEmail=noreply@mojjo.com
SmtpSettings__FromName=Mojjo Grocery & Drinks
